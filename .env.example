# =============================================================================
# Frontend (Vite / Vercel) — Main site + Growth + Network
# Copy to .env and fill in real values: cp .env.example .env
# =============================================================================

VITE_SUPABASE_URL=https://kong-production-3917.up.railway.app
# Same anon key as master-os NEXT_PUBLIC_SUPABASE_ANON_KEY
VITE_SUPABASE_ANON_KEY=your_anon_key_here
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# VITE_PARTNER_PORTAL_GET_STARTED_URL=http://localhost:3001/get-started

# Optional — main site B2C booking (Google Maps autocomplete)
# VITE_GOOGLE_API_KEY=

# =============================================================================
# Supabase Edge Function secrets — set in Supabase Dashboard or CLI, NOT here.
# See GROWTH-SETUP.md and: npm run setup:secrets:print
# =============================================================================

# Stripe (test: sk_test_... / whsec_test_... | live: sk_live_... / whsec_...)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Growth checkout (£379 one-off — amount loaded from STRIPE_GROWTH_PRICE_ID)
STRIPE_GROWTH_PRICE_ID=price_...

# Network checkout (subscriptions)
# STRIPE_NETWORK_MONTHLY_PRICE_ID=price_...
# STRIPE_NETWORK_ANNUAL_PRICE_ID=price_...

# Google Calendar (Growth onboarding + main-site "Schedule a meeting")
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GROWTH_CALENDAR_ID=your-calendar-id@group.calendar.google.com
# GROWTH_NOTIFY_EMAIL=victor@getfixfy.com

# Transactional email (Growth booking confirmations)
# RESEND_API_KEY=re_...

# Network invite links (?access=TOKEN skips payment)
# NETWORK_ACCESS_TOKENS=token1,token2

# Use /api/growth in dev/Vercel (Railway edge /functions/v1 returns 401). Optional override:
# VITE_GROWTH_API_URL=/api/growth

# =============================================================================
# B2C booking (getfixfy.com main site: end of tenancy clean, paint, fix)
# Server-side only (Vercel env + api/b2c/*). In dev the master-os .env.local
# next door already provides MASTER_OS_JOB_WEBHOOK_API_KEY and RESEND_API_KEY.
# =============================================================================

# 'test' (default): no OS job and no email. 'live': OS jobs (with Zendesk ticket) + emails.
# Set to 'live' on purpose, on Vercel, when the office is ready to receive bookings.
B2C_BOOKING_MODE=test
# Payment is Stripe Checkout (hosted page), so only the SECRET key is needed.
# sk_test_ opens Checkout in any mode (test cards). sk_live_ only opens it when
# B2C_BOOKING_MODE=live, so nobody pays real money for a booking that is not recorded.
# Falls back to STRIPE_SECRET_KEY when unset.
# B2C_STRIPE_SECRET_KEY=sk_test_...
# Signing secret of the Stripe webhook endpoint https://getfixfy.com/api/b2c/webhook
# (event checkout.session.completed). Safety net for customers who pay and close the tab.
# B2C_STRIPE_WEBHOOK_SECRET=whsec_...
# Where jobs are created. Locally the OS dev server writes to production.
MASTER_OS_URL=http://localhost:3000
# MASTER_OS_JOB_WEBHOOK_API_KEY=
# accounts.id of the "Fixfy" account for direct customers (else looked up by name).
# FIXFY_ACCOUNT_ID=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Fixfy <hello@getfixfy.com>
# B2C_NOTIFY_EMAIL=victor@getfixfy.com

# Browser (public) Mapbox token for the address search in the booking.
# Same public token as the OS (NEXT_PUBLIC_MAPBOX_TOKEN). Without it the booking
# falls back to typing the address by hand.
# VITE_MAPBOX_TOKEN=pk....
